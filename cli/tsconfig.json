{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@api/*": ["../frontend/src/api/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
