{
  "name": "agent-hub-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write .",
    "postinstall": "node -e \"const fs=require('node:fs');for(const d of ['golang','php','python'])fs.rmSync('node_modules/flatted/'+d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.0.0",
    "@lobehub/ui": "^5.29.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "antd": "^6.1.0",
    "antd-style": "^4.1.0",
    "axios": "^1.8.0",
    "dayjs": "^1.11.13",
    "jszip": "^3.10.1",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "msw": "^2.4.0",
    "prettier": "^3.0.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "dompurify": "^3.4.13",
    "postcss": "^8.5.23",
    "esbuild": "^0.28.1"
  }
