# ===== Auth (optional) =====

# JWT signing secret for the builtin auth mode (>=32 bytes).
# Generate one with:  openssl rand -hex 32
# Optional: when empty, the server generates a random secret at first startup
# and persists it in the hub_data volume (/data/.jwt-secret) — restarts and
# upgrades keep sessions valid. Set this explicitly for production and for
# multi-replica deployments (replicas must share one secret).
AUTH_JWT_SECRET=

# ===== Database =====
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_hub

# ===== Server =====
# Host port to expose the hub on (the app listens on this port internally).
HUB_PORT=8081
DATABASE_MAX_OPEN=50

# Image to pull for the hub service (default stack only; the build override
# compiles from source instead). Override if you use a different registry/mirror.
# HUB_IMAGE=zeroneai/agent-hub

# ===== agent-deployer (runtime deployment) =====

# API key shared between hub and deployer. Generate one with:
#   openssl rand -hex 32
# Leave empty to disable deployer auth (local dev only — always set in production).
AGENT_DEPLOYER_API_KEY=

# Absolute path ON THE DOCKER HOST holding deployer state (agent configs,
# sessions, skills). The same path is bind-mounted into the deployer container
# and every runtime container it creates, so it must be identical on both
# sides — do not use a relative path.
#   Linux:   /var/lib/agent-deployer
#   macOS:   /Users/<you>/somewhere/agent-hub-data/deployer
DEPLOYER_DATA_DIR=

# Host used to reach runtime containers (browser + hub health probes connect to
# <public-host>:<dynamic-port>). Use localhost for local runs; use the server's
# public IP/domain for remote deployments — and make sure the firewall /
# security group allows the Docker ephemeral port range (32768-60999).
AGENT_DEPLOYER_PUBLIC_HOST=localhost

# Images to pull. Defaults are Docker Hub (zeroneai/*). For China networks,
# use the Huawei Cloud SWR mirrors instead:
# DEPLOYER_IMAGE=swr.cn-east-3.myhuaweicloud.com/zerone/deployer
# RUNTIME_IMAGE=swr.cn-east-3.myhuaweicloud.com/zerone/runtime

# ===== Optional integrations (leave commented/empty to disable) =====

# Encryption key for stored provider API keys (any non-empty string).
# PROVIDER_ENCRYPTION_KEY=

# Kong gateway integration (empty = no-op).
# KONG_ADMIN_URL=

# Knowledge base (MultiRAG) integration.
# MULTIRAG_BASE_URL=
# MULTIRAG_API_KEY=
